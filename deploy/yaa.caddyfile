# /etc/caddy/Caddyfile.d/yaa.legner.me.caddyfile
# Plain HTTP: TLS terminates at Cloudflare, cloudflared connects to localhost:80.
http://yaa.legner.me {
  encode zstd gzip

  # Demo data from yaa-poller.service.
  handle_path /data/* {
    root * /run/yaa
    header Cache-Control no-store
    file_server
  }

  # Alternative: live data from a home feeder on the LAN.
  # handle /data/* {
  #   reverse_proxy http://192.168.1.50:8080
  # }

  handle {
    root * /srv/http/yaa/
    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    try_files {path} /index.html
    file_server
  }
}
